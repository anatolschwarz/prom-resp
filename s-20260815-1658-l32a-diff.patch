diff --git a/e2e/teaTime.e2e.ts b/e2e/teaTime.e2e.ts
new file mode 100644
index 0000000..75517d4
--- /dev/null
+++ b/e2e/teaTime.e2e.ts
@@ -0,0 +1,199 @@
+import { expect, test, type Locator, type Page } from "@playwright/test";
+
+async function gamePoint(canvas: Locator, point: { x: number; y: number }) {
+  const box = await canvas.boundingBox();
+  if (!box) throw new Error("Game canvas is not visible.");
+  return {
+    x: box.x + (point.x / 960) * box.width,
+    y: box.y + (point.y / 540) * box.height,
+  };
+}
+
+async function movePart(
+  page: Page,
+  canvas: Locator,
+  from: { x: number; y: number },
+  to: { x: number; y: number },
+) {
+  const start = await gamePoint(canvas, from);
+  const end = await gamePoint(canvas, to);
+  await page.mouse.move(start.x, start.y);
+  await page.mouse.down();
+  await page.mouse.move(end.x, end.y, { steps: 12 });
+  await page.mouse.up();
+}
+
+async function openTeaTime(page: Page) {
+  await page.goto("/");
+  await expect(page.locator("#game-container canvas")).toBeVisible();
+  await page.getByRole("button", { name: "Settings" }).click();
+  await page.getByLabel("Puzzle locking").check();
+  await page.getByLabel("Unlock all puzzles").check();
+  await page.locator("#puzzle-selector-button").click();
+  await page.locator('[data-puzzle-id="tea-time-008"]').click();
+  await expect(page.locator("#puzzle-title-label")).toHaveText("Tea Time");
+}
+
+interface BrowserTeaTimeResult {
+  contacts: string[][];
+  goalReached: boolean;
+  teapotVelocity?: { x: number; y: number };
+}
+
+async function runBrowserMatterTicks(
+  page: Page,
+  ticks: number,
+): Promise<BrowserTeaTimeResult> {
+  return page.evaluate((tickCount) => {
+    const scene =
+      window.__contraptionLabTest?.getPrototypeScene() as unknown as {
+        matter: {
+          world: {
+            on: (
+              event: string,
+              callback: (event: {
+                pairs: Array<{
+                  bodyA: { label: string; velocity: { x: number; y: number } };
+                  bodyB: { label: string; velocity: { x: number; y: number } };
+                }>;
+              }) => void,
+            ) => void;
+          };
+        };
+        setSimulationRunning: (running: boolean) => void;
+        update: (time: number, delta: number) => void;
+      };
+    if (!scene) throw new Error("Prototype scene is unavailable.");
+
+    const contacts: string[][] = [];
+    let teapotVelocity: { x: number; y: number } | undefined;
+    scene.matter.world.on("collisionstart", (event) => {
+      for (const pair of event.pairs) {
+        const labels = [pair.bodyA.label, pair.bodyB.label];
+        contacts.push(labels);
+        if (
+          labels.includes("ball:tea-marble") &&
+          labels.includes("teapot:tray-teapot-1")
+        ) {
+          const ball =
+            pair.bodyA.label === "ball:tea-marble" ? pair.bodyA : pair.bodyB;
+          teapotVelocity = { ...ball.velocity };
+        }
+      }
+    });
+    scene.setSimulationRunning(true);
+    for (let tick = 0; tick < tickCount; tick += 1) {
+      scene.update(0, 1000 / 60);
+    }
+    scene.setSimulationRunning(false);
+    return {
+      contacts,
+      goalReached:
+        document.querySelector("#mode-label")?.textContent === "Mode: Success",
+      teapotVelocity,
+    };
+  }, ticks);
+}
+
+test("places the Storybook Teapot and Plank, then solves Tea Time", async ({
+  page,
+}) => {
+  test.setTimeout(60_000);
+  const errors: string[] = [];
+  page.on("pageerror", (error) => errors.push(error.message));
+  page.on("console", (message) => {
+    if (message.type() === "error") errors.push(message.text());
+  });
+  await page.goto("/");
+  const canvas = page.locator("#game-container canvas");
+  await expect(canvas).toBeVisible();
+  await page.getByRole("button", { name: "Settings" }).click();
+  await page.getByLabel("Puzzle locking").check();
+  await page.getByLabel("Unlock all puzzles").check();
+  await page.locator("#puzzle-selector-button").click();
+  await page.locator('[data-puzzle-id="tea-time-008"]').click();
+  await expect(page.locator("#puzzle-title-label")).toHaveText("Tea Time");
+  if (!(await page.locator("#parts-palette").isVisible()))
+    await page.locator("#parts-palette-toggle").click();
+  await page.locator("#tray-teapot-button").click();
+  await page.locator("#tray-ramp-button").click();
+  await movePart(page, canvas, { x: 520, y: 180 }, { x: 490, y: 307 });
+  await expect
+    .poll(() =>
+      page.evaluate(() => {
+        const scene =
+          window.__contraptionLabTest?.getPrototypeScene() as unknown as {
+            teapots: Map<
+              string,
+              {
+                shape: { x: number; y: number };
+                sprite?: { texture: { key: string } };
+              }
+            >;
+            ramps: Map<
+              string,
+              { shape: { x: number; y: number; rotation: number } }
+            >;
+            level: {
+              goal: { x: number; y: number };
+              blocks: Array<{ id: string; y: number }>;
+            };
+          };
+        const teapot = scene?.teapots.get("tray-teapot-1");
+        const ramp = scene?.ramps.get("tray-ramp-1");
+        return {
+          teapot: teapot && {
+            x: teapot.shape.x,
+            y: teapot.shape.y,
+            texture: teapot.sprite?.texture.key,
+          },
+          ramp: ramp && {
+            x: ramp.shape.x,
+            y: ramp.shape.y,
+            rotation: ramp.shape.rotation,
+          },
+          underTable:
+            scene.level.goal.y >
+            scene.level.blocks.find(
+              (block) => block.id === "tabletop-center-geometry",
+            )!.y,
+        };
+      }),
+    )
+    .toEqual({
+      teapot: { x: 650, y: 340, texture: "storybook-teapot-idle" },
+      ramp: { x: 490, y: 307, rotation: 0.17 },
+      underTable: true,
+    });
+  await page.locator("#simulation-button").click();
+  const result = await runBrowserMatterTicks(page, 600);
+  expect(
+    result.contacts.some(
+      (labels) =>
+        labels.includes("ball:tea-marble") &&
+        labels.includes("teapot:tray-teapot-1"),
+    ),
+  ).toBe(true);
+  expect(result.teapotVelocity).toBeDefined();
+  expect(result.teapotVelocity!.x).toBeLessThan(0);
+  expect(result.teapotVelocity!.y).toBeGreaterThan(0);
+  expect(result.goalReached).toBe(true);
+  await page.getByRole("button", { name: "Reset" }).click();
+  await expect(page.locator("#tray-teapot-label")).toHaveText("Teapot (1)");
+  await expect(page.locator("#tray-ramp-label")).toHaveText("Ramp (1)");
+  expect(errors).toEqual([]);
+});
+
+test("does not send the marble to the cup without a Teapot contact", async ({
+  page,
+}) => {
+  await openTeaTime(page);
+
+  await page.locator("#simulation-button").click();
+  const result = await runBrowserMatterTicks(page, 600);
+
+  expect(result.goalReached).toBe(false);
+  expect(
+    result.contacts.flat().some((label) => label.startsWith("teapot:")),
+  ).toBe(false);
+});

